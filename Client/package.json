{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "server": "npm run dev --prefix ../SERVER",
    "dev_server": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "next build",
    "start": "next build && next start --port 8080 --hostname 0.0.0.0",
    "lint": "next lint",
    "help": "next start -h"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "concurrently": "^9.1.2",
    "next": "15.3.3",
    "notiflix": "^3.2.8",
    "phosphor-react": "^1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "24.0.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.28.0",
    "eslint-config-next": "15.3.3",
    "typescript": "5.8.3"
  }
}
